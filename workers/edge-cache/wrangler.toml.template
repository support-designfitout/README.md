# Wrangler Configuration Template for Edge Cache Worker
# 
# IMPORTANT: This is a template for Cloudflare Workers deployment.
# The repository is cloud-agnostic. For other platforms, see WORKER_DEPLOYMENT.md
#
# To use this template:
# 1. Copy this file to wrangler.toml
# 2. Replace ACCOUNT_ID with your Cloudflare account ID
# 3. Adjust worker name and routes as needed
# 4. Run: wrangler deploy

name = "edge-cache"
main = "index.js"
compatibility_date = "2024-01-01"

# Account configuration - REPLACE WITH YOUR VALUES
# account_id = "ACCOUNT_ID"

# Routes configuration
# Uncomment and configure based on your domain setup
# routes = [
#   { pattern = "fitoutlab.app/*", zone_name = "fitoutlab.app" },
#   { pattern = "designfitout.com/*", zone_name = "designfitout.com" }
# ]

# Environment variables
[env.production]
# Add your production environment variables here
# vars = { VERSION = "1.0.0" }

[env.staging]
# Add your staging environment variables here
# vars = { VERSION = "1.0.0-staging" }

[env.development]
# Add your development environment variables here
# vars = { VERSION = "1.0.0-dev" }

# KV namespaces (if needed for caching)
# [[kv_namespaces]]
# binding = "CACHE_KV"
# id = "your-kv-namespace-id"
