# Wrangler Configuration Template for API Gateway Worker
# 
# IMPORTANT: This is a template for Cloudflare Workers deployment.
# The repository is cloud-agnostic. For other platforms, see WORKER_DEPLOYMENT.md
#
# To use this template:
# 1. Copy this file to wrangler.toml
# 2. Replace ACCOUNT_ID with your Cloudflare account ID
# 3. Adjust worker name and routes as needed
# 4. Run: wrangler deploy

name = "api-gateway"
main = "index.js"
compatibility_date = "2024-01-01"

# Account configuration - REPLACE WITH YOUR VALUES
# account_id = "ACCOUNT_ID"

# Routes configuration
# Uncomment and configure based on your domain setup
# routes = [
#   { pattern = "fitoutlab.app/api/*", zone_name = "fitoutlab.app" },
#   { pattern = "designfitout.com/api/*", zone_name = "designfitout.com" }
# ]

# Environment variables
[env.production]
vars = { VERSION = "1.0.0" }

[env.staging]
vars = { VERSION = "1.0.0-staging" }

[env.development]
vars = { VERSION = "1.0.0-dev" }

# KV namespaces (if needed)
# [[kv_namespaces]]
# binding = "API_CACHE"
# id = "your-kv-namespace-id"

# Durable Objects (if needed)
# [[durable_objects.bindings]]
# name = "API_STATE"
# class_name = "APIState"
# script_name = "api-gateway"
