#!/bin/bash
# Pre-commit hook for Designfitout-Github
# This hook automatically formats Go code and runs validation checks before each commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔧 Running pre-commit hooks...${NC}"

# Check if we're in a Git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}❌ Not in a Git repository${NC}"
    exit 1
fi

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Variables to track what was processed
GO_FILES_PROCESSED=false
VALIDATION_PASSED=true

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Process Go files
GO_FILES=$(echo "$STAGED_FILES" | grep '\.go$' | tr '\n' ' ')
if [ -n "$GO_FILES" ] && [ "$GO_FILES" != " " ]; then
    echo -e "${BLUE}📝 Processing Go files...${NC}"
    GO_FILES_PROCESSED=true
    
    # Format Go files with gofmt
    if command_exists gofmt; then
        echo -e "${YELLOW}  Formatting Go files with gofmt...${NC}"
        for file in $GO_FILES; do
            if [ -f "$file" ]; then
                gofmt -w "$file"
                git add "$file"
                echo -e "${GREEN}  ✅ Formatted: $file${NC}"
            fi
        done
    else
        echo -e "${YELLOW}  ⚠️ gofmt not found, skipping Go formatting${NC}"
    fi
    
    # Run goimports if available
    if command_exists goimports; then
        echo -e "${YELLOW}  Organizing imports with goimports...${NC}"
        for file in $GO_FILES; do
            if [ -f "$file" ]; then
                goimports -w "$file"
                git add "$file"
                echo -e "${GREEN}  ✅ Imports organized: $file${NC}"
            fi
        done
    else
        echo -e "${YELLOW}  ⚠️ goimports not found, skipping import organization${NC}"
    fi
    
    # Run basic Go syntax check
    if command_exists go; then
        echo -e "${YELLOW}  Checking Go syntax...${NC}"
        for file in $GO_FILES; do
            if [ -f "$file" ]; then
                if ! go fmt "$file" > /dev/null 2>&1; then
                    echo -e "${RED}  ❌ Go syntax error in: $file${NC}"
                    VALIDATION_PASSED=false
                fi
            fi
        done
    fi
fi

# Run brand neutrality validation for any changes
echo -e "${BLUE}🔍 Running brand neutrality validation...${NC}"
if command_exists node; then
    if [ -f "test-brand-neutrality.js" ]; then
        if node test-brand-neutrality.js > /dev/null 2>&1; then
            echo -e "${GREEN}✅ Brand neutrality validation passed${NC}"
        else
            echo -e "${RED}❌ Brand neutrality validation failed${NC}"
            echo -e "${YELLOW}Run 'node test-brand-neutrality.js' to see details${NC}"
            VALIDATION_PASSED=false
        fi
    else
        echo -e "${YELLOW}⚠️ Brand neutrality test not found, skipping validation${NC}"
    fi
else
    echo -e "${YELLOW}⚠️ Node.js not found, skipping brand neutrality validation${NC}"
fi

# Check for common issues in any modified files
if [ -n "$STAGED_FILES" ]; then
    echo -e "${BLUE}🔍 Checking for common issues...${NC}"
    
    # Check for hard-coded cloud provider references (brand neutrality)
    BANNED_TERMS=("firebase" "cloudflare" "ga4" "gsc")
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && [[ "$file" =~ \.(js|go|rb|ts|jsx|tsx|py|java)$ ]]; then
            for term in "${BANNED_TERMS[@]}"; do
                # Skip if the file is a test file that might legitimately mention these terms
                if [[ "$file" =~ test.*\.(js|go|rb|ts)$ ]] && grep -i "banned.*terms\|test.*$term" "$file" > /dev/null; then
                    continue
                fi
                
                if grep -i "$term" "$file" > /dev/null; then
                    # Check if it's in a policy context (allowed)
                    if ! grep -i "banned.*terms\|policy\|prohibited" "$file" > /dev/null; then
                        echo -e "${RED}❌ Found banned term '$term' in: $file${NC}"
                        echo -e "${YELLOW}  Use configuration variables instead of hard-coded references${NC}"
                        VALIDATION_PASSED=false
                    fi
                fi
            done
        fi
    done
    
    # Check for trailing whitespace
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && [[ "$file" =~ \.(js|go|rb|ts|jsx|tsx|py|java|md|yml|yaml|json)$ ]]; then
            if grep -q '[[:space:]]\+$' "$file"; then
                echo -e "${YELLOW}⚠️ Found trailing whitespace in: $file${NC}"
                # Auto-fix trailing whitespace
                sed -i 's/[[:space:]]*$//' "$file"
                git add "$file"
                echo -e "${GREEN}  ✅ Fixed trailing whitespace in: $file${NC}"
            fi
        fi
    done
fi

# Final status
echo ""
if [ "$VALIDATION_PASSED" = true ]; then
    if [ "$GO_FILES_PROCESSED" = true ]; then
        echo -e "${GREEN}🎉 Pre-commit checks passed! Go files formatted and validated.${NC}"
    else
        echo -e "${GREEN}🎉 Pre-commit checks passed!${NC}"
    fi
    echo -e "${BLUE}📝 Commit ready to proceed...${NC}"
    exit 0
else
    echo -e "${RED}❌ Pre-commit checks failed. Please fix the issues above and try again.${NC}"
    exit 1
fi