    "development-standards": {
      "ai-assistance": {
        "code-generation": {
          "templates": true,
          "auto-completion": true,
          "smart-suggestions": true,
          "pattern-recognition": true
        },
        "code-review": {
          "automated-analysis": true,
          "security-scanning": true,
          "performance-optimization": true,
          "best-practices-enforcement": true
        },
        "testing": {
          "ai-generated-tests": true,
          "test-case-suggestions": true,
          "coverage-optimization": true,
          "regression-testing": true
        },
        "documentation": {
          "auto-generation": true,
          "smart-comments": true,
          "api-documentation": true,
          "user-guides": true
        }
      },
      "cloud-agnostic": {
        "required": true,
        "banned-terms": ["firebase", "cloudflare", "ga4", "gsc"],
        "configuration-driven": true,
        "vendor-neutral": true
      },
      "performance": {
        "core-web-vitals": true,
        "lighthouse-score": ">= 90",
        "load-time": "< 3s",
        "ai-optimization": true
      },
      "security": {
        "csp-headers": true,
        "input-validation": true,
        "ai-security-analysis": true,
        "vulnerability-scanning": true
      }
    },
    "ai-workflow-templates": {
      "feature-development": [
        "Analyze requirements with AI",
        "Generate initial code structure",
        "Implement core functionality",
        "Add AI enhancements",
        "Generate tests automatically",
        "Optimize with AI suggestions",
        "Document with AI assistance"
      ],
      "bug-fixing": [
        "AI-powered issue analysis",
        "Root cause identification",
        "Solution generation",
        "Implementation with AI assistance",
        "Automated regression testing",
        "Performance impact analysis"
      ],
      "optimization": [
        "Performance bottleneck detection",
        "AI-suggested improvements",
        "Code refactoring assistance",
        "Automated testing",
        "Performance monitoring"
      ]
    },
    "integration": {
      "github-copilot": {
        "enabled": true,
        "features": [
          "Code completion",
          "Function generation",
          "Test creation",
          "Documentation writing",
          "Bug fixing assistance"
        ]
      },
      "custom-ai-apis": {
        "enabled": true,
        "base-url": "${AI_API_BASE_URL}",
        "authentication": "Bearer token",
        "rate-limiting": true
      }
    }
