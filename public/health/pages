<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health Check - Pages Status</title>
    <script>
        // Serve JSON content for API consumers
        if (window.location.search.includes('format=json') || 
            (document.referrer && document.referrer.includes('api')) ||
            window.navigator.userAgent.includes('curl') ||
            window.navigator.userAgent.includes('wget')) {
            
            const healthData = {
                "status": "healthy",
                "service": "Designfitout Static Pages Health Check",
                "timestamp": new Date().toISOString(),
                "pages": [
                    {
                        "url": "/",
                        "path": "/index.html",
                        "status": "active",
                        "description": "Main landing page with video integration"
                    },
                    {
                        "url": "/ind2x.html",
                        "path": "/ind2x.html", 
                        "status": "active",
                        "description": "FitOutLab capsule interface"
                    }
                ],
                "features": [
                    "Video Integration",
                    "Strategic Analysis",
                    "Glassmorphism Design",
                    "Responsive Layout"
                ],
                "domains": {
                    "primary": "fitoutlab.app",
                    "secondary": "designfitout.com"
                },
                "cache": {
                    "enabled": true,
                    "maxAge": 3600
                }
            };
            
            document.addEventListener('DOMContentLoaded', function() {
                document.body.innerHTML = '<pre>' + JSON.stringify(healthData, null, 2) + '</pre>';
                document.querySelector('pre').style.fontFamily = 'monospace';
                document.querySelector('pre').style.margin = '20px';
            });
        }
    </script>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f5f8fb;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        h1 { color: #1a237e; margin-bottom: 20px; }
        .status { color: #4caf50; font-weight: bold; }
        .pages-list { margin: 20px 0; }
        .page-item { 
            background: #f8f9fa; 
            padding: 10px; 
            margin: 5px 0; 
            border-radius: 4px; 
            border-left: 4px solid #1976d2;
        }
        pre { background: #f5f5f5; padding: 20px; border-radius: 4px; overflow-x: auto; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🏥 Health Check - Pages Status</h1>
        <p>Status: <span class="status">✅ Healthy</span></p>
        <p>Service: Designfitout Static Pages Health Check</p>
        <p>Timestamp: <span id="timestamp"></span></p>
        
        <h2>📋 Available Pages</h2>
        <div class="pages-list">
            <div class="page-item">
                <strong>/</strong> - Main landing page with video integration
                <br><small>Status: Active</small>
            </div>
            <div class="page-item">
                <strong>/ind2x.html</strong> - FitOutLab capsule interface
                <br><small>Status: Active</small>
            </div>
        </div>
        
        <h2>🔧 Features</h2>
        <ul>
            <li>Video Integration</li>
            <li>Strategic Analysis</li>
            <li>Glassmorphism Design</li>
            <li>Responsive Layout</li>
        </ul>
        
        <h2>🌐 Domains</h2>
        <ul>
            <li><strong>Primary:</strong> fitoutlab.app</li>
            <li><strong>Secondary:</strong> designfitout.com</li>
        </ul>
        
        <p><strong>API Usage:</strong> Add <code>?format=json</code> to get JSON response</p>
    </div>
    
    <script>
        document.getElementById('timestamp').textContent = new Date().toISOString();
    </script>
</body>
</html>