#!/usr/bin/env sh

################################################################################
# Husky Pre-commit Hook (Sample)
#
# This is a sample pre-commit hook for the Husky Git hooks framework.
# It runs npm tests and detect-secrets scan before allowing commits.
#
# Setup Instructions:
#   1. Install husky: npm install --save-dev husky
#   2. Initialize husky: npx husky install
#   3. Make this file executable: chmod +x .husky/pre-commit
#   4. Install detect-secrets: pip install detect-secrets
#   5. Initialize baseline: detect-secrets scan > .secrets.baseline
#
# Note: This hook is optional and requires manual setup.
#       See RUNBOOK.md for detailed instructions.
#
################################################################################

. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."
echo ""

# Run npm tests (if applicable)
# Uncomment the following lines to enable npm test on commit
# echo "📦 Running npm tests..."
# npm test
# if [ $? -ne 0 ]; then
#   echo "❌ Tests failed. Commit aborted."
#   exit 1
# fi
# echo "✅ Tests passed"
# echo ""

# Run detect-secrets scan (if installed)
if command -v detect-secrets > /dev/null 2>&1; then
  echo "🔐 Scanning for secrets..."
  
  # Check if baseline exists
  if [ ! -f .secrets.baseline ]; then
    echo "⚠️  No .secrets.baseline found. Creating one..."
    detect-secrets scan > .secrets.baseline
  fi
  
  # Scan staged files
  detect-secrets-hook --baseline .secrets.baseline $(git diff --cached --name-only)
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Potential secrets detected!"
    echo ""
    echo "To resolve:"
    echo "  1. Remove the secret from your changes"
    echo "  2. If it's a false positive, update the baseline:"
    echo "     detect-secrets scan --baseline .secrets.baseline"
    echo "  3. Try committing again"
    echo ""
    exit 1
  fi
  
  echo "✅ No secrets detected"
else
  echo "⚠️  detect-secrets not installed. Skipping secret scan."
  echo "   Install with: pip install detect-secrets"
fi

echo ""
echo "✅ All pre-commit checks passed!"
