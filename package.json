{
  "name": "designfitout-github",
  "version": "1.0.0",
  "description": "FitOutLab Capsule - Premium Design & Fitout Solutions",
  "main": "test-brand-neutrality.js",
  "scripts": {
    "dev": "npx http-server public -p 3000 -c-1",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:validate": "playwright test --config=playwright.config.minimal.ts",
    "test:brand-neutrality": "node test-brand-neutrality.js",
    "test:mrketoz-crm": "node test-mrketoz-crm.js",
    "test:mobile-auth": "node test-mobile-auth.js",
    "test:vibe-coding": "node test-vibe-coding-features.js",
    "test:e2e-structure": "node test-e2e-structure.js",
    "test:ops-snapshot": "node test-ops-snapshot.js",
    "test:all": "npm run test:brand-neutrality && npm run test:mrketoz-crm && npm run test:mobile-auth && npm run test:vibe-coding && npm run test:e2e-structure && npm run test:ops-snapshot",
    "test:all-with-e2e": "npm run test:all && npm run test",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "designfitout",
    "fitoutlab",
    "playwright",
    "testing",
    "e2e"
  ],
  "author": "Arun K Ravi (this4arun@gmail.com)",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "http-server": "^14.1.1"
  }
}
